# ---- Backend ----
TURSO_DATABASE_URL=file:./data/laundry.db
# TURSO_DATABASE_URL=https://<your-database>.turso.io
# TURSO_AUTH_TOKEN=

JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d

PORT=3000
NODE_ENV=development

FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Optional overrides used by the seed script ----
SEED_BUSINESS_NAME=Demo Laundry
SEED_BUSINESS_COUNTRY=IN
SEED_BUSINESS_CURRENCY=INR
SEED_BUSINESS_TIMEZONE=Asia/Kolkata
SEED_DEFAULT_CALLING_COUNTRY=IN
SEED_TAX_NAME=GST
SEED_TAX_BP=500

SEED_OWNER_EMAIL=owner@demo.laundry
SEED_OWNER_PASSWORD=Owner@1234
SEED_ADMIN_EMAIL=admin@demo.laundry
SEED_ADMIN_PASSWORD=Admin@1234
SEED_MANAGER_EMAIL=manager@demo.laundry
SEED_MANAGER_PASSWORD=Manager@1234
SEED_STAFF_EMAIL=staff@demo.laundry
SEED_STAFF_PASSWORD=Staff@1234

# ---- Frontend ----
# Vite reads VITE_* vars from frontend/.env.local automatically
VITE_API_BASE_URL=/api